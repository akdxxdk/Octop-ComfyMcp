# ============================================================
# .env.example  —  template for local configuration
# ============================================================
# 1. Copy this file to `.env`  (`.env` is gitignored — never commit it)
# 2. Replace EVERY /abs/path/to/... value below with YOUR real paths
# 3. These variables are expanded into config/comfyui-mcp-connector.example.json
#    by scripts/setup-connector.py  (it substitutes ${VAR} placeholders)
#
# Use forward or back slashes — Windows accepts both in these paths.
# ============================================================

# Isolated venv where comfy-mcp is installed (NOT Octop's conda env)
COMFYMCP_VENV=/abs/path/to/comfymcp-venv

# Octop's conda env (comfy-cli lives here, exposes comfy.exe)
OCTOP_CONDA_ENV=/abs/path/to/octop-conda-env

# Optional: shared ComfyUI model directory (extra_model_paths.yaml base_path)
COMFY_SHARED_MODELS=/abs/path/to/shared-models

# Optional: aki bundle root (passed to scripts/start-comfyui.bat)
COMFYUI_AKI_ROOT=/abs/path/to/aki-root

# Octop admin credentials.
# Also overridable via OCTOP_USER / OCTOP_PASS environment variables,
# or via --username / --password CLI args to the setup scripts.
OCTOP_USER=admin
OCTOP_PASS=
